<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon\GenerateUnrealEngineServerTool.ico</ApplicationIcon>
    <!-- CI ではタグから採番して -p:Version= で上書きする。ローカルビルドの既定値。 -->
    <Version>0.0.0</Version>
    <Company>SingleClickCompany</Company>
    <Product>GenerateUnrealEngineServerTool</Product>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="icon\GenerateUnrealEngineServerTool.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>